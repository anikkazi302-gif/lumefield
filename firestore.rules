rules_version = '2';

// LumeField credit wallets + one-way signup claims + daily refill + referrals (v5) — paste this whole
// file into Firebase console > lumeField project > Build > Firestore
// Database > Rules tab, then click Publish. See FIRESTORE-SETUP.md.
//
// What it does:
// 1. Wallets (collection "wallets", doc id = Firebase Auth user id): a
//    signed-in user with a VERIFIED email can read and write ONLY their own
//    wallet. Unverified emails get nothing — the site sends a verification
//    email on sign-up, and the wallet only opens after the user clicks the
//    link. This stops unlimited free accounts farming the 20-credit signup
//    bonus with fake/temporary emails.
//      - Create: only with exactly 20 credits, only the allowed fields,
//        only if this email has never claimed the bonus before, and never
//        from a temporary/disposable email address (top ~105 domains blocked
//        here; the site also blocks ~560 at sign-up — no list is complete,
//        new temp domains appear daily, so update the list over time).
//      - Update: credits may ONLY go down by exactly one valid video cost
//        (5s = 4, 10s = 7, 20s = 14, 30s = 20), optionally counting the build
//        (builds +1). Two narrow exceptions, both capped: (a) the DAILY FREE
//        REFILL — credits up by exactly 4, only with lastDailyClaim set to a
//        new, later, valid YYYY-MM-DD date (the site only ever claims
//        today's Asia/Dhaka date; the rules enforce format + strictly
//        increasing date, so a fake future date is the only residual hole —
//        worth 4 credits a throw, far less than a fresh email's 20, see §4);
//        (b) the REFERRAL REWARD — credits up by exactly 20, only paid by
//        the referred user themself, only while their referrals doc names
//        this wallet as referrer and is still unpaid (rewarded == false).
//        No other field may change except updatedAt (plus builds /
//        lastDailyClaim in their own cases). Nobody can raise their own
//        balance, create extra credits, or touch another user's wallet.
//      - Create: may also carry referredBy (uid of the inviter, never the
//        user's own uid) and lastDailyClaim (valid date string, normally
//        absent at creation).
//      - Delete: never allowed.
// 2. Claims (collection "claimed", doc id = NORMALIZED email): one-way
//    record that an email has already taken its one 20-credit signup bonus.
//    The site creates it in the SAME transaction as the wallet, so both
//    succeed or neither does. Deleting a Firebase Auth account does NOT
//    delete Firestore documents, so the claim SURVIVES account deletion —
//    deleting the account and re-registering with the SAME email can never
//    create a new wallet (the wallet-create rule below blocks it).
//    Gmail trick closed: dots and +tags are stripped before the key is
//    built (user.name+tag@gmail.com == username@gmail.com), so the same
//    Gmail cannot re-claim via +aliases or dots. Clients can only CREATE a
//    claim for their own verified email, only once; nobody (not even the
//    owner of that email) can read, update or delete it.
//    A COMPLETELY NEW email can still register — no site can stop that
//    without phone verification or a paid identity check.
// 3. Referrals (collection "referrals", doc id = REFERRED user id): one doc
//    per invited friend, created by the referred user after they verify
//    their email and build their first video plan. The referrer earns 20
//    credits, paid by the referred user in the same transaction that flips
//    rewarded false -> true — the flip is one-way, so the reward can never
//    pay twice. Self-referral is blocked (referrerUid != referredUid).
//    Readable by the referred user and by the referrer (profile stats).
// 4. Honest limit (daily refill): the rules cannot compute "today" from a
//    date string, so they enforce format + strictly increasing date. A user
//    calling Firestore directly with fake future dates could claim +4 per
//    fake day — deliberate SDK abuse for 4 credits a throw, while the same
//    user could simply register a new email for 20. Not worth a Cloud
//    Function; the client always claims the real Asia/Dhaka date.
// 5. Everything else in the database: denied.
service cloud.firestore {
  match /databases/{database}/documents {
    // Normalized email: Gmail ignores dots and +tags, so
    // user.name+tag@gmail.com and username@gmail.com are the same mailbox.
    function normEmail(e) {
      return e.lower().matches('.*@(gmail[.]com|googlemail[.]com)$')
        ? e.lower().split('@')[0].split('[+]')[0].split('[.]').join('') + '@gmail.com'
        : e.lower();
    }
    // Top ~105 temporary/disposable email domains (see the site's sign-up
    // check for the wider ~560-domain list).
    function isDisposableEmail(e) {
      return e.lower().matches('.*@(0-00[.]usa[.]cc|0-30-24[.]com|0-attorney[.]com|0-mail[.]com|0-mailer[.]dynv6[.]net|00-tv[.]com|00[.]0[.]gmail[.]com[.]gmail[.]8[.]3[.]gmail[.]35[.]cad[.]creou[.]dev|00[.]msk[.]ru|00[.]pe|000-webmail[.]myhome-server[.]de|000000000000000[.]theworkpc[.]com|000000000000000000[.]dynv6[.]net|000476[.]com|000728[.]xyz|000777[.]info|00082cc[.]com|000email[.]com|000webmail[.]ddnss[.]de|000webmail[.]ddnss[.]org|000webmail[.]dyn-ip24[.]de|000webmail[.]dyn[.]ddnss[.]de|000webmail[.]dyn[.]home-webserver[.]de|000webmail[.]dyndns[.]ddnss[.]de|000webmail[.]dyndns1[.]de|000webmail[.]home-webserver[.]de|001[.]igg[.]biz|001041[.]xyz|001218[.]xyz|001260[.]xyz|001310[.]xyz|001gmail[.]com|002gmail[.]com|002r[.]com|002t[.]com|003271[.]com|0033[.]pl|0039[.]cf|0039[.]ga|0039[.]gq|0039[.]ml|003j[.]com|004k[.]com|005005[.]xyz|0055betplataforma[.]com|0058[.]ru|10mail[.]org|10minutemail[.]com|10minutemail[.]net|10minutemail[.]org|20minutemail[.]com|33mail[.]com|anonbox[.]net|dispostable[.]com|e4ward[.]com|emailondeck[.]com|fakeinbox[.]com|getairmail[.]com|getnada[.]com|guerrillamail[.]biz|guerrillamail[.]com|guerrillamail[.]de|guerrillamail[.]net|guerrillamail[.]org|inboxbear[.]com|mailcatch[.]com|maildrop[.]cc|mailforspam[.]com|mailinator[.]com|mailinator[.]net|mailinator[.]org|mailinator2[.]com|mailmetrash[.]com|mailnesia[.]com|mailnull[.]com|mintemail[.]com|moakt[.]com|mohmal[.]com|mytemp[.]email|mytrashmail[.]com|sharklasers[.]com|spam4[.]me|spambox[.]us|spamgourmet[.]com|temp-mail[.]io|temp-mail[.]org|tempail[.]com|tempemail[.]co|tempinbox[.]com|tempmail[.]com|tempmail[.]de|tempmail[.]net|tempmailaddress[.]com|tempmailo[.]com|tempomail[.]fr|throwawaymail[.]com|tmail[.]ws|tmpmail[.]com|tmpmail[.]org|trashmail[.]com|trashmail[.]me|trashmail[.]net|trashmail[.]org|yopmail[.]com|yopmail[.]fr|yopmail[.]net)$');
    }

    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.token.email_verified == true && request.auth.uid == userId
        && request.resource.data.credits == 20
        && request.resource.data.keys().hasOnly(['credits', 'createdAt', 'updatedAt', 'referredBy', 'lastDailyClaim'])
        && (!('referredBy' in request.resource.data) || (request.resource.data.referredBy is string && request.resource.data.referredBy != request.auth.uid))
        && (!('lastDailyClaim' in request.resource.data) || (request.resource.data.lastDailyClaim is string && request.resource.data.lastDailyClaim.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && !isDisposableEmail(request.auth.token.email)
        && !exists(/databases/$(database)/documents/claimed/$(normEmail(request.auth.token.email)));

      allow update: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.credits >= 0
        && (
          // A: own wallet, debit by exactly one valid video cost (old shape, no builds field).
          (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt'])
            && (request.resource.data.credits == resource.data.credits - 4
                || request.resource.data.credits == resource.data.credits - 7
                || request.resource.data.credits == resource.data.credits - 14
                || request.resource.data.credits == resource.data.credits - 20))
          // B: own wallet, debit by a valid cost AND count the build (builds +1).
          || (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt', 'builds'])
            && (request.resource.data.credits == resource.data.credits - 4
                || request.resource.data.credits == resource.data.credits - 7
                || request.resource.data.credits == resource.data.credits - 14
                || request.resource.data.credits == resource.data.credits - 20)
            && ('builds' in request.resource.data)
            && request.resource.data.builds == ((('builds' in resource.data) ? resource.data.builds : 0) + 1))
          // C: own wallet, daily free refill — credits up by exactly 4, only
          // with lastDailyClaim set to a new, later, valid YYYY-MM-DD date.
          || (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt', 'lastDailyClaim'])
            && request.resource.data.credits == resource.data.credits + 4
            && ('lastDailyClaim' in request.resource.data)
            && request.resource.data.lastDailyClaim is string
            && request.resource.data.lastDailyClaim.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && (!('lastDailyClaim' in resource.data) || request.resource.data.lastDailyClaim > resource.data.lastDailyClaim))
          // D: referral reward — paid by the REFERRED user (request.auth.uid)
          // to the referrer's wallet (userId): credits up by exactly 20,
          // only while the referrals doc keyed by the referred user names
          // this wallet as referrer and is still unpaid (rewarded == false).
          || (request.auth.uid != userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt'])
            && request.resource.data.credits == resource.data.credits + 20
            && exists(/databases/$(database)/documents/referrals/$(request.auth.uid))
            && get(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerUid == userId
            && get(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.rewarded == false)
        );

      allow delete: if false;
    }

    match /claimed/{email} {
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && normEmail(request.auth.token.email) == email
        && !isDisposableEmail(request.auth.token.email)
        && !exists(/databases/$(database)/documents/claimed/$(email))
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == email;

      allow read, update, delete: if false;
    }

    match /referrals/{referredUid} {
      // Create: only by the referred user themself, verified, naming a real
      // referrer (never themself), unpaid, with the allowed fields only.
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == referredUid
        && request.resource.data.keys().hasOnly(['referrerUid', 'rewarded', 'createdAt'])
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != referredUid
        && request.resource.data.rewarded == false;

      // Read: the referred user and the referrer (profile stats). A query
      // filtered by referrerUid == the requester's uid is permitted.
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && (request.auth.uid == referredUid || request.auth.uid == resource.data.referrerUid);

      // Update: only the one-way flip false -> true (the reward payment),
      // by the referred user or the referrer; nothing else may change.
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && (request.auth.uid == referredUid || request.auth.uid == resource.data.referrerUid)
        && resource.data.rewarded == false
        && request.resource.data.rewarded == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewarded', 'updatedAt']);

      allow delete: if false;
    }

    // Count cap (20 per user) is enforced in the site code; these rules bound
    // each document's size instead. A server-side count needs wallet counters.
    match /characters/{charId} {
      // Create: only your own verified account, exact fields, sane sizes,
      // photo must be a JPEG/PNG/WebP data URL (downscaled by the site).
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'description', 'photoDataUrl', 'createdAt'])
        && request.resource.data.uid is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.photoDataUrl is string
        && request.resource.data.photoDataUrl.size() <= 400000
        && request.resource.data.photoDataUrl.matches('^data:image/(jpeg|png|webp);base64,.*$');

      // Read: only the owner. A query filtered by uid == request.auth.uid is permitted.
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == resource.data.uid;

      // Update: only the owner; uid and createdAt can never change.
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'name', 'description', 'photoDataUrl', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.photoDataUrl is string
        && request.resource.data.photoDataUrl.size() <= 400000
        && request.resource.data.photoDataUrl.matches('^data:image/(jpeg|png|webp);base64,.*$');

      allow delete: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == resource.data.uid;
    }

    match /savedVideos/{videoId} {
      // Create: only your own verified account, exact fields, sane sizes,
      // video URL must be https (an engine page, never javascript: or data:).
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'modelId', 'modelName', 'planText', 'videoUrl', 'createdAt'])
        && request.resource.data.uid is string
        && request.resource.data.modelId is string && request.resource.data.modelId.size() >= 1 && request.resource.data.modelId.size() <= 40
        && request.resource.data.modelName is string && request.resource.data.modelName.size() >= 1 && request.resource.data.modelName.size() <= 80
        && request.resource.data.planText is string && request.resource.data.planText.size() <= 20000
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 500
        && request.resource.data.videoUrl.matches('^https://.*$');

      // Read: only the owner. A query filtered by uid == request.auth.uid is permitted.
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == resource.data.uid;

      // Update: only the owner; uid, modelId and createdAt can never change.
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.modelId == resource.data.modelId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'modelId', 'modelName', 'planText', 'videoUrl', 'createdAt'])
        && request.resource.data.modelName is string && request.resource.data.modelName.size() >= 1 && request.resource.data.modelName.size() <= 80
        && request.resource.data.planText is string && request.resource.data.planText.size() <= 20000
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 500
        && request.resource.data.videoUrl.matches('^https://.*$');

      allow delete: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == resource.data.uid;
    }

match /{document=**} {
      allow read, write: if false;
    }
  }
}
